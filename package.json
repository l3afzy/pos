{
  "name": "pos-terminal",
  "productName": "POS Terminal",
  "version": "4.1.0",
  "private": true,
  "description": "Point of sale for retail and quick-service stores, with Thai Revenue Department tax documents",
  "author": "l3afzy",
  "license": "Apache-2.0",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.l3afzy.posterminal",
    "productName": "POS Terminal",
    "artifactName": "POS-Terminal-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS Terminal",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "syncDesktopName": true
    }
  },
  "desktopName": "pos-terminal.desktop"
}
